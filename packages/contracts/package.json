{
  "name": "@blockbase/contracts",
  "version": "0.3.2",
  "description": "Shared contracts, schemas and exit codes for Blockbase.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "fixtures",
    "!dist/**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/taylorsegell/blockbase.git",
    "directory": "packages/contracts"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
