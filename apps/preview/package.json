{
  "name": "@blockbase/preview",
  "version": "0.3.2",
  "description": "Blockbase catalog page server: renders catalog components with Vite.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "index.html",
    "src",
    "!src/server",
    "components.json",
    "!dist/**/*.tsbuildinfo"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @blockbase/contracts build && pnpm --filter @blockbase/core build && tsc -p tsconfig.server.json",
    "typecheck": "pnpm --filter @blockbase/contracts build && pnpm --filter @blockbase/core build && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@blockbase/contracts": "workspace:*",
    "@blockbase/core": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@studio-freight/lenis": "^1.0.42",
    "@tailwindcss/vite": "^4.1.12",
    "@vitejs/plugin-react": "^5.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "dotted-map": "^3.1.0",
    "framer-motion": "^12.23.12",
    "gsap": "^3.15.0",
    "lenis": "^1.3.11",
    "lucide-react": "^0.542.0",
    "motion": "^13.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.1.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/taylorsegell/blockbase.git",
    "directory": "apps/preview"
  },
  "publishConfig": {
    "access": "public"
  }
}
